# Скопируйте файл в .env и добавьте ключ перед запуском ingest.py.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_QUERY_MODEL=gpt-6-luna
OPENAI_ANSWER_MODEL=gpt-6.1-sol

# Папка с первоисточниками фиксирована: source/.
# Путь ниже задаётся относительно папки проекта.
DATA_DIR=data
TICKETS_PATH=data/tickets.sqlite3
DAILY_QUESTION_LIMIT=100

# Параметры разбиения используются при индексации; параметры поиска — в search.py.
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=60
SEMANTIC_TOP_K=8
BM25_TOP_K=8
CONTEXT_TOP_K=5
RRF_K=60
MAX_USER_QUESTIONS=15
MAX_QUESTION_CHARS=4000
MAX_ANSWER_CHARS=2500

